[node name="Static NPC22" parent="tilemap/Static NPC" unique_id=877962812 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-1101.8334, -744.3333)
DialogueMessages = Array[String](["Adoro pescar nesse rio.", "É o único momento que tenho de paz."])

[node name="Static NPC23" parent="tilemap/Static NPC" unique_id=1577177382 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-5.833374, -284.66663)
DialogueMessages = Array[String](["Já rezou hoje, rapaz?", "Se não, pelo seu bem...", "É melhor se fazer presente.", "Dica de amigo para amigo.", "Depois não diga que não avisei.", "[color=gold]Numa Pompílio[/color] já ensinou...", "as práticas e ritos, não tem erro."])

[node name="Static NPC24" parent="tilemap/Static NPC" unique_id=2040610354 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-1262.1666, -1714)
DialogueMessages = Array[String](["Só jogando conversa fora."])
Direction = 1

[node name="Static NPC25" parent="tilemap/Static NPC" unique_id=169604273 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-1292.8334, -1713.6666)
