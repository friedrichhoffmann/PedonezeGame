DialogueMessages = Array[String](["Vocé não é um Plebeu?", "Claro que não. Olha pra você.", "Se não estaria trabalhando.", "Se não vai ajudar, então xô."])
Direction = 5

[node name="Static NPC4" parent="tilemap/Static NPC" unique_id=1149898280 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-665.1666, -825.3333)
DialogueMessages = Array[String](["Quem esse palhaço...", "pensa que é?"])
Direction = 3
MessageInterval = 2.0

[node name="Static NPC5" parent="tilemap/Static NPC" unique_id=734021217 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-690.49994, -825.3333)
DialogueMessages = Array[String](["Diante dessa situação, o que...", "pensaria nosso fundador [color=gold]Rômulo[/color]? ", "O homem matou o próprio irmão.", "Não mataria esse rei corrupto?"])
Direction = 3

[node name="Static NPC6" parent="tilemap/Static NPC" unique_id=9865076 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-715.8334, -825.3333)
DialogueMessages = Array[String](["Sai daí, pateta! Salafrário!", "Lugar de palhaço é no circo!", "Deixe a gente resolver os problemas!"])
Direction = 3

[node name="Static NPC7" parent="tilemap/Static NPC" unique_id=1560626198 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-740.8334, -825.3333)
Direction = 3

[node name="Static NPC8" parent="tilemap/Static NPC" unique_id=166743514 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-740.8334, -825.3333)
DialogueMessages = Array[String](["Minhas pernas estão doendo.", "Não aguento mais tra alhar!", "Você já esteve no nosso lugar?"])
Direction = 3

[node name="Static NPC9" parent="tilemap/Static NPC" unique_id=1396189447 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-504.16666, -1776.3334)
DialogueMessages = Array[String](["Trigo, uva ou azeitona?", "Um por 5, dois por 8. Que tal?"])

[node name="Static NPC10" parent="tilemap/Static NPC" unique_id=570779341 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-534.8333, -1744.6666)
Direction = 5

[node name="Static NPC11" parent="tilemap/Static NPC" unique_id=249632816 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-534.8333, -1726.6666)
DialogueMessages = Array[String](["Um dia eu estarei no lugar desse capataz.", "Uma enxadada bem dada...", "Ou melhor: ir bem longe daqui.", "É... eu ficaria até mais contente."])
Direction = 5

[node name="Static NPC12" parent="tilemap/Static NPC" unique_id=1093505664 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-535.1666, -1708.9999)
DialogueMessages = Array[String](["Nós estamos trabalhando...", "Para um rei que malemá governa.", "Mesmo eu faria algo melhor.", "É só fazer mais dinheiro.", "Nossa... que idéia boa que eu tive!", "Vê? Eu deveria participar...", "do [color=gold]Senado[/color] como conselheiro."])
Direction = 5

[node name="Static NPC13" parent="tilemap/Static NPC" unique_id=989102748 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-535.1666, -1689.9999)
DialogueMessages = Array[String](["Adoro tomar um vinho.", "Mais prazeroso que água.", "Só penso nisso enquanto capino.", "Ei, você! Tem alguma garrafa aí?"])
Direction = 5

[node name="Static NPC14" parent="tilemap/Static NPC" unique_id=74584539 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-474.16666, -1717.9999)
DialogueMessages = Array[String](["Vida de camponês não é fácil.", "Pelo menos tem quem faça isso.", "Antes eles do que eu."])
Direction = 1
MessageInterval = 4.95

[node name="Static NPC15" parent="tilemap/Static NPC" unique_id=1487159078 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-390.16663, -2065)
DialogueMessages = Array[String](["Eu acho engraçado...", "Esses peixes, só estão vivendo...", "Vivendo, sem preocupação com a vida."])
Direction = 3
MessageInterval = 3.0

[node name="Static NPC17" parent="tilemap/Static NPC" unique_id=2007130435 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(341.83337, -1055.3334)
DialogueMessages = Array[String](["Ouviu o que esse outro rapaz disse?", "Esse debaixo."])

[node name="Static NPC16" parent="tilemap/Static NPC" unique_id=377365339 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(341.83337, -1037.3334)
DialogueMessages = Array[String](["Não fala pra ninguém.", "Mas esse imperador deveria...", "Ter o mesmo destino de [color=gold]Remo[/color]."])
