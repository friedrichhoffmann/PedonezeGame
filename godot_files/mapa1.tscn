[node name="Static NPC28" parent="tilemap/Static NPC" unique_id=277109495 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(357.5, -1888.6666)
DialogueMessages = Array[String](["Gostou do Ágape de hoje?", "Ah, olá, amigo. Você como fiel...", "veio trazer comida aos pobres?", "...", "Pelo visto,  você só tem a espada."])
Direction = 3

[node name="Static NPC29" parent="tilemap/Static NPC" unique_id=1719450240 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-292.49994, -1712)
DialogueMessages = Array[String](["Demorei demais ai dentro.", "Era melhor estar capinando."])

[node name="Static NPC30" parent="tilemap/Static NPC" unique_id=2122250568 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-1600.5, -1142.3333)
DialogueMessages = Array[String](["Hoje há tantos problemas.", "No começo era assim. será?", "[color=gold]753 a.C[/color] não parece tão longe."])
Direction = 1

[node name="Static NPC31" parent="tilemap/Static NPC" unique_id=737414349 instance=ExtResource("26_tbndf")]
position = Vector2(-992.5, -245.66669)
DialogueMessages = Array[String](["Não que tenham me perguntado...", "mas já tivemos imperadores...", "melhores. Quer um exemplo?", "[color=gold]Túlio Hostílio[/color], conhece? Não?", "Pois se informe mais, rapaz.", "Ele pelo menos tinha iniciativa...", "de tentar conquistar algo.", "Nunca ouviu falar de Alba Longa?"])
Direction = 5

[node name="Static NPC32" parent="tilemap/Static NPC" unique_id=832488608 instance=ExtResource("26_tbndf")]
position = Vector2(-1782.8334, -1544)
DialogueMessages = Array[String](["Esse rio, com esse fluxo...", "Me lembra do [color=gold]Rio Tibre[/color].", "Já estive lá uma vez. ", "Na minha visita à Roma."])
Direction = 1

[node name="Static NPC33" parent="tilemap/Static NPC" unique_id=159325350 instance=ExtResource("26_tbndf")]
position = Vector2(-859.8334, -1927)
DialogueMessages = Array[String](["Rapaz, por favor, me dê licença.", "Quero tomar um banho aqui.", "...", "Que foi, vai ficar olhando?"])

[node name="Static NPC34" parent="tilemap/Static NPC" unique_id=287932819 instance=ExtResource("26_tbndf")]
position = Vector2(-1311.1666, -1044.6666)
DialogueMessages = Array[String](["Não se importe com esses dois.", "É que esse de bandana preta...", "roubou uma maçã do outro rapaz.", "Nossa, que perseguição feia.", "É algo que você veria num circo.", "Daqueles do [color=gold]Tarquínio Prisco[/color]"])
Direction = 3

[node name="Static NPC35" parent="tilemap/Static NPC" unique_id=325074818 instance=ExtResource("26_tbndf")]
position = Vector2(-44.166706, -1735.9999)
DialogueMessages = Array[String](["Olha só esses dois correndo.", "Eles estão treinando...", "para o serviço militar.", "E essa lerdeza é sem equipamento.", "Imagine com armadura...", "Parecem [color=gold]sabinos[/color] fugindo."])

[node name="Static NPC36" parent="tilemap/Static NPC" unique_id=1182692034 instance=ExtResource("26_tbndf")]
position = Vector2(-55.166718, -2321)
DialogueMessages = Array[String](["Essas pedras são bem unfiromes.", "Me lembra a muralha de Roma.", "Quem a ergueu mesmo?", "Ah, [color=gold]Sérvio Túlio[/color]. Quase esqueci."])
Direction = 3

[node name="Static NPC37" parent="tilemap/Static NPC" unique_id=1795948925 instance=ExtResource("26_tbndf")]
position = Vector2(-245.49998, -1446.9999)
DialogueMessages = Array[String](["Shhhhhhhhh!!!", "Fique quieto. Tá vendo?", "Aqueles dois na árvore.", "Eles são bandidos. Dos ruins.", "Se você chegar perto, bom...", "pelo menos vou conseguir correr."])

[node name="Static NPC38" parent="tilemap/Static NPC" unique_id=1664471978 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-1551.1666, -997.3333)
DialogueMessages = Array[String](["Ei, me devolve isso! Vacilão!", "Salafrário, ônagro, cafajeste!", "Não me faça buscar meu arco!"])
Direction = 1

[node name="Static NPC39" parent="tilemap/Static NPC" unique_id=1731140587 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(-1333.8333, -95.33331)
DialogueMessages = Array[String](["Sabe o que eu sinto falta?", "Uma ponte. Uma de madeira.", "Tal qual fez [color=gold]Anco Márcio[/color].", "Ele edificou a primeira ponte...", "sobre o [color=gold]Rio Tibre[/color], em Roma.", "Ter que depender de um bote...", "é horrível. Uma pedra no sapato."])
Direction = 1

[node name="Static NPC40" parent="tilemap/Static NPC" unique_id=368774966 instance=ExtResource("26_tbndf")]
z_index = 500
texture_filter = 1
position = Vector2(358.50012, -1345.6667)
DialogueMessages = Array[String](["Essa arena... minha nossa!", "Deviam pegar uma dessa e colocar na...", "[color=gold]Colina Palatina[/color], em Roma."])
Direction = 3

[node name="Static NPC41" parent="tilemap/Static NPC" unique_id=399132669 instance=ExtResource("26_tbndf")]
